# Copier ce fichier en .env et adapter les valeurs

# Identifiants pour docker-compose.yml (MongoDB local de test)
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=Test1234

# Chaîne de connexion utilisée par scripts/load_data.py et par le serveur MCP
# Local (docker-compose ci-dessus) :
MONGODB_URI=mongodb://admin:Test1234@localhost:27017/?authSource=admin

# Azure DocumentDB (exemple - remplacer par les valeurs de votre cluster) :
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongocluster.cosmos.azure.com/?tls=true&authMechanism=SCRAM-SHA-256

MONGODB_DB=traveldb

MCP_MAX_RESULTS=20
ENABLE_WRITE_TOOLS=false
ENABLE_MANAGEMENT_TOOLS=false

# GROQ API KEY
GROQ_API_KEY=
# GROQ MODEL
GROQ_MODEL_AGENT=openai/gpt-oss-120b

# FLASK SESSION SECRET
FLASK_SECRET_KEY=MySuperSecretPhrase123!